NODE_ENV=production
PORT=8080
AWS_REGION=us-east-1
APP_SECRET_ARN=arn:aws:secretsmanager:us-east-1:YOUR_ACCOUNT_ID:secret:kt-orders-primary-XXXXXX
DB_CA_FILE=/etc/kantin-orders/rds-global-bundle.pem
DB_SSL=true
# FALSE for standby, even if you accidentally point at a writable database.
WRITE_ENABLED=true
