# Copy to config.tfvars and upload it as the Jenkins Secret file credential aws-lab-tfvars.
# AWS access keys do not belong here; Jenkins supplies them separately.
account_id     = "123456789012"
ssh_public_key = "ssh-ed25519 AAAA... Kantin Tongue AWS lab"

