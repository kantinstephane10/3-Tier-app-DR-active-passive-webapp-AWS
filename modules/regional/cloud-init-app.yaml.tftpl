#cloud-config
package_update: true
packages: [python3]
write_files:
  - path: /opt/aws-demo/app.py
    permissions: '0644'
    content: |
      import json, socket
      from http.server import BaseHTTPRequestHandler, HTTPServer
      class Handler(BaseHTTPRequestHandler):
          def do_GET(self):
              if self.path == '/health':
                  body = b'healthy'
              else:
                  body = json.dumps({'owner':'Kantin Tongue','region':'${region}','host':socket.gethostname(),'database_endpoint':'${database_endpoint}','database_connected':False}).encode()
              self.send_response(200)
              self.send_header('Content-Type','application/json')
              self.end_headers()
              self.wfile.write(body)
      HTTPServer(('0.0.0.0',8080),Handler).serve_forever()
  - path: /etc/systemd/system/aws-demo.service
    content: |
      [Unit]
      After=network-online.target
      Wants=network-online.target
      [Service]
      User=www-data
      ExecStart=/usr/bin/python3 /opt/aws-demo/app.py
      Restart=always
      [Install]
      WantedBy=multi-user.target
runcmd:
  - systemctl daemon-reload
  - systemctl enable --now aws-demo
