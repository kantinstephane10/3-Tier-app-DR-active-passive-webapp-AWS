#cloud-config
package_update: true
packages: [nginx]
write_files:
  - path: /etc/nginx/sites-available/default
    content: |
      server {
        listen 80 default_server;
        # Re-resolve the internal ALB, whose addresses change over time.
        resolver 169.254.169.253 valid=30s;
        set $app_upstream http://${app_lb}:8080;
        location = /health { proxy_pass $app_upstream; }
        location / { proxy_pass $app_upstream; proxy_set_header Host $host; }
      }
runcmd:
  - systemctl enable nginx
  - nginx -t
  - systemctl restart nginx
